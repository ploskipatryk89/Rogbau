<?xml version="1.0" encoding="utf-8"?>
<!--
Ten plik jest wykorzystywany przez proces publikowania/pakowania projektu internetowego. Możesz dostosować zachowanie tego procesu
 poprzez edycję tego pliku MSBuild. Aby dowiedzieć się więcej o tym działaniu, odwiedź stronę https://go.microsoft.com/fwlink/?LinkID=208121. 
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <IsLinux>true</IsLinux>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <ResourceId>/subscriptions/894169a3-3a35-4e0b-bcee-d33c0744d8eb/resourceGroups/Rogbau/providers/Microsoft.Web/sites/rogbau-magazyn</ResourceId>
    <ResourceGroup>Rogbau</ResourceGroup>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <SiteUrlToLaunchAfterPublish>https://rogbau-magazyn-brezc8bshqbdfpas.polandcentral-01.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <ProjectGuid>210c46d7-977f-f039-75b5-15fd30b6fac7</ProjectGuid>
    <PublishUrl>https://rogbau-magazyn-brezc8bshqbdfpas.scm.polandcentral-01.azurewebsites.net/</PublishUrl>
    <UserName />
    <_SavePWD>false</_SavePWD>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <Target Name="PrepareAzureWebFiles" BeforeTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../../Rogbau.Frontend" Command="npm run build" />
    <ItemGroup>
      <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeAzureWebFiles" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('appsettings')) And '%(ResolvedFileToPublish.Extension)' == '.json'" />
      <_AzureFrontend Include="$(MSBuildProjectDirectory)/../../Rogbau.Frontend/dist/**/*" />
      <ResolvedFileToPublish Include="@(_AzureFrontend)">
        <RelativePath>wwwroot/%(_AzureFrontend.RecursiveDir)%(_AzureFrontend.Filename)%(_AzureFrontend.Extension)</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)/Properties/PublishProfiles/azure-appsettings.config">
        <RelativePath>appsettings.json</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
